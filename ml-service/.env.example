# Copy to .env and adjust. Never commit .env.

# Where uvicorn binds. The backend reaches this service at ML_SERVICE_URL,
# set in backend/.env.
HOST=127.0.0.1
PORT=8000

# Training data. The PHMSA gas distribution flagged file is gitignored — see
# the repository .gitignore — so place it here yourself:
#   ml-service/data/gd2010toPresent.xlsx
# Source: https://www.phmsa.dot.gov/data-and-statistics
PHMSA_DATA_PATH="data/gd2010toPresent.xlsx"
