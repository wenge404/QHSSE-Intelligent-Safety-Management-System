// ============================================================================
// Intelligent QHSSE Safety Management System (IQSMS) — Database Schema
// Gaz du Cameroun / University of Buea internship defense project
// ============================================================================
// Design notes:
//
// 1. KPIs (CACR, MTTC, NMFR) are deliberately NOT stored as their own tables.
//    They are computed with aggregate queries over Incident / Audit /
//    CorrectiveAction so the dashboard is never showing stale numbers.
//    See proposal §11.
//
// 2. CorrectiveAction and Attachment can originate from either an Incident or
//    an AuditResponse. Prisma has no native polymorphic relation, so this uses
//    the standard workaround: a `source` enum plus two optional foreign keys.
//    "Exactly one FK set" is enforced in the API layer (Zod refinement in
//    src/schemas/correctiveAction.ts).
//
// 3. Checklists use a template/instance split: ChecklistTemplate +
//    ChecklistItem are the reusable definition ("Monthly Fire Safety
//    Inspection"), Audit is one dated run of a template at a Zone, and
//    AuditResponse is the recorded answer to each item for that run.
//
// 4. Incident.causeCategory follows the 8-category apparent-cause taxonomy
//    from PHMSA Form F 7100.1 Part G, matching MAP_EIGHT_CAUSE in the
//    training data so logged incidents and training records share one
//    cause vocabulary. See proposal §10.2.
//
// 5. Role names and the incident state machine follow the proposal
//    (§9.2, §9.3) rather than any earlier draft schema: four roles, and the
//    six-state lifecycle DRAFT → SUBMITTED → UNDER_INVESTIGATION →
//    CORRECTIVE_ACTION_PENDING → VERIFIED → CLOSED.
//
// 6. AuditLog is insert-only at the application layer — no update or delete
//    path is exposed through the API. See proposal §9.4.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------ Enums --------------------------------------

/// Proposal §9.3 RBAC matrix.
enum Role {
  FIELD_REPORTER
  QHSSE_AUDITOR
  DEPARTMENT_LEAD
  SYSTEM_ADMIN
}

enum ZoneType {
  WELLHEAD
  PROCESSING_FACILITY
  PIPELINE_SECTION
  DISTRIBUTION_NETWORK
  OFFICE
  OTHER
}

enum IncidentType {
  INCIDENT
  NEAR_MISS
}

/// PHMSA F 7100.1 Part G apparent-cause categories (G1–G8).
enum CauseCategory {
  CORROSION_FAILURE
  NATURAL_FORCE_DAMAGE
  EXCAVATION_DAMAGE
  OTHER_OUTSIDE_FORCE
  PIPE_WELD_JOINT_FAILURE
  EQUIPMENT_FAILURE
  INCORRECT_OPERATION
  OTHER_UNKNOWN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Proposal §9.2 workflow state machine. Valid transitions are declared in
/// src/domain/stateMachine.ts and enforced by the API before any write.
enum IncidentStatus {
  DRAFT
  SUBMITTED
  UNDER_INVESTIGATION
  CORRECTIVE_ACTION_PENDING
  VERIFIED
  CLOSED
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
  OBSERVATION
}

enum CorrectiveActionSource {
  INCIDENT
  AUDIT_RESPONSE
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  VERIFIED
}

// The five enums below are deliberately 1:1 with the distinct values actually
// present in gd2010toPresent.xlsx, verified against the file rather than
// assumed. A lossy platform→PHMSA lookup would silently push unmapped options
// into an unseen category that OneHotEncoder drops at inference time, so the
// vocabulary is kept identical on both sides instead.

/// PHMSA LOCATION_TYPE — a set-A model feature.
enum LocationType {
  PRIVATE_PROPERTY
  PUBLIC_PROPERTY
  UTILITY_ROW_EASEMENT
  OPERATOR_CONTROLLED_PROPERTY
}

/// PHMSA SYSTEM_PART_INVOLVED — a set-A model feature.
enum SystemPart {
  MAIN
  SERVICE
  SERVICE_RISER
  SERVICE_VALVE
  MAIN_VALVE
  OUTSIDE_METER_REGULATOR_SET
  INSIDE_METER_REGULATOR_SET
  DISTRICT_REGULATOR_METERING_STATION
  FARM_TAP_METER_REGULATOR_SET
  OTHER
}

/// PHMSA RELEASE_TYPE — a set-B (triage) feature.
enum ReleaseType {
  LEAK
  RUPTURE
  MECHANICAL_PUNCTURE
  OTHER
}

/// PHMSA INCIDENT_AREA_TYPE — a set-B (triage) feature.
enum IncidentAreaType {
  UNDERGROUND
  ABOVEGROUND
  TRANSITION_AREA
}

/// PHMSA MATERIAL_INVOLVED — a set-B (triage) feature.
enum PipeMaterial {
  STEEL
  PLASTIC
  CAST_WROUGHT_IRON
  DUCTILE_IRON
  COPPER
  UNKNOWN
  OTHER
}

// ------------------------------ Models -------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(FIELD_REPORTER)
  /// Scope key for DEPARTMENT_LEAD visibility (proposal §9.3).
  department   String?
  /// Scope key for QHSSE_AUDITOR zone-level visibility (proposal §9.3).
  zoneId       Int?
  zone         Zone?    @relation("UserHomeZone", fields: [zoneId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportedIncidents Incident[]         @relation("IncidentReportedBy")
  conductedAudits   Audit[]            @relation("AuditConductedBy")
  assignedActions   CorrectiveAction[] @relation("ActionAssignedTo")
  verifiedActions   CorrectiveAction[] @relation("ActionVerifiedBy")
  auditLogEntries   AuditLog[]

  @@index([role])
  @@map("users")
}

model Zone {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  zoneType ZoneType
  /// Owning department — the scope key for DEPARTMENT_LEAD visibility.
  department String?
  notes    String?

  incidents  Incident[]
  audits     Audit[]
  residents  User[]     @relation("UserHomeZone")
  hourLogs   OperationalHours[]

  @@map("zones")
}

model Incident {
  id              Int          @id @default(autoincrement())
  referenceNumber String       @unique
  type            IncidentType @default(INCIDENT)
  title           String
  description     String

  occurredAt   DateTime
  reportedAt   DateTime @default(now())
  reportedById Int
  reportedBy   User     @relation("IncidentReportedBy", fields: [reportedById], references: [id])

  zoneId Int?
  zone   Zone? @relation(fields: [zoneId], references: [id])

  // --- Cause (PHMSA-aligned, see design note 4) ---
  causeCategory    CauseCategory?
  causeDescription String?

  // --- Set A features: circumstances knowable before an incident ---
  systemPart       SystemPart?
  locationType     LocationType?
  /// PHMSA ACCIDENT_PSIG. Note: PHMSA's ACCIDENT_PRESSURE is a categorical
  /// MAOP-exceedance field despite its name, and is not the numeric pressure.
  linePressurePsig    Decimal? @db.Decimal(8, 2)
  /// PHMSA PIPE_DIAMETER, nominal inches.
  pipeDiameterInches  Decimal? @db.Decimal(6, 2)

  // --- Set B features: incident characteristics, known once logged ---
  ignitionOccurred Boolean?
  explosionOccurred Boolean?
  pipeMaterial     PipeMaterial?
  releaseType      ReleaseType?
  incidentAreaType IncidentAreaType?
  /// Derived to PIPE_AGE at scoring time: occurredAt.year - yearInstalled.
  yearInstalled    Int?

  // --- Consequence / severity (never sent to the model: leakage, §8.2) ---
  severity             RiskLevel @default(LOW)
  fatalities           Int       @default(0)
  injuries             Int       @default(0)
  propertyDamageCost   Decimal?  @db.Decimal(12, 2)
  gasVolumeReleasedMcf Decimal?  @db.Decimal(10, 2)
  evacuationCount      Int       @default(0)

  // --- Asset context ---
  assetType        String?
  scadaPresent     Boolean?
  scadaOperational Boolean?

  status IncidentStatus @default(DRAFT)

  // --- Predictive module output (design note 5) ---
  predictedRiskLevel RiskLevel?
  predictedRiskScore Decimal?   @db.Decimal(5, 4)
  predictedByModel   String?
  predictedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  correctiveActions CorrectiveAction[]
  attachments       Attachment[]

  @@index([status])
  @@index([causeCategory])
  @@index([occurredAt])
  @@index([type])
  @@index([reportedById])
  @@index([zoneId])
  @@map("incidents")
}

model ChecklistTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  category    String?
  /// ISO clause this template evidences, e.g. "ISO 9001:2015 §9.2".
  isoClause   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  items  ChecklistItem[]
  audits Audit[]

  @@map("checklist_templates")
}

model ChecklistItem {
  id         Int               @id @default(autoincrement())
  templateId Int
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemText   String
  category   String?
  orderIndex Int               @default(0)

  responses AuditResponse[]

  @@index([templateId])
  @@map("checklist_items")
}

model Audit {
  id              Int               @id @default(autoincrement())
  referenceNumber String            @unique
  templateId      Int
  template        ChecklistTemplate @relation(fields: [templateId], references: [id])

  zoneId Int?
  zone   Zone? @relation(fields: [zoneId], references: [id])

  conductedById Int
  conductedBy   User @relation("AuditConductedBy", fields: [conductedById], references: [id])

  scheduledDate DateTime
  conductedDate DateTime?
  status        AuditStatus @default(PLANNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses AuditResponse[]

  @@index([status])
  @@index([zoneId])
  @@index([conductedById])
  @@map("audits")
}

model AuditResponse {
  id               Int              @id @default(autoincrement())
  auditId          Int
  audit            Audit            @relation(fields: [auditId], references: [id], onDelete: Cascade)
  checklistItemId  Int
  checklistItem    ChecklistItem    @relation(fields: [checklistItemId], references: [id])
  complianceStatus ComplianceStatus
  notes            String?

  correctiveActions CorrectiveAction[]
  attachments       Attachment[]

  @@unique([auditId, checklistItemId])
  @@map("audit_responses")
}

model CorrectiveAction {
  id              Int                    @id @default(autoincrement())
  referenceNumber String                 @unique
  description     String

  source          CorrectiveActionSource
  incidentId      Int?
  incident        Incident?              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  auditResponseId Int?
  auditResponse   AuditResponse?         @relation(fields: [auditResponseId], references: [id], onDelete: Cascade)

  assignedToId Int
  assignedTo   User @relation("ActionAssignedTo", fields: [assignedToId], references: [id])

  /// Set when the action is created — the "raised" timestamp for MTTC (§11).
  raisedAt      DateTime @default(now())
  dueDate       DateTime
  completedDate DateTime?
  status        CorrectiveActionStatus @default(OPEN)

  verifiedById Int?
  verifiedBy   User?     @relation("ActionVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([assignedToId])
  @@map("corrective_actions")
}

model Attachment {
  id              Int            @id @default(autoincrement())
  fileUrl         String
  fileName        String?
  fileType        String?
  incidentId      Int?
  incident        Incident?      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  auditResponseId Int?
  auditResponse   AuditResponse? @relation(fields: [auditResponseId], references: [id], onDelete: Cascade)
  uploadedAt      DateTime       @default(now())

  @@map("attachments")
}

/// Insert-only compliance trail (proposal §9.4). Every state mutation across
/// the platform is appended here. The API exposes no update or delete route.
model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entityType    String
  entityId      Int
  previousState String?
  newState      String?
  /// Free-form JSON detail (changed fields, request context).
  detail        Json?
  ipAddress     String?
  timestamp     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
  @@map("audit_log")
}

/// Denominator for the Near-Miss Frequency Rate (proposal §11):
/// NMFR = (near-misses / person-hours) x 200,000.
model OperationalHours {
  id          Int      @id @default(autoincrement())
  periodStart DateTime
  periodEnd   DateTime
  personHours Decimal  @db.Decimal(12, 2)
  zoneId      Int?
  zone        Zone?    @relation(fields: [zoneId], references: [id])
  createdAt   DateTime @default(now())

  @@index([periodStart, periodEnd])
  @@map("operational_hours")
}
