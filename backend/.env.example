# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string.
# This default matches docker-compose.yml at the repository root, which maps the
# container to host port 5433 so it cannot collide with a locally installed
# PostgreSQL on 5432.
DATABASE_URL="postgresql://iqsms:123@localhost:5433/iqsms?schema=public"

# To use a locally installed PostgreSQL instead, create the database first
#   createdb -U postgres iqsms
# and point at it:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/iqsms?schema=public"

# API
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Auth — use a long random string, not this placeholder
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# ML microservice
ML_SERVICE_URL="http://127.0.0.1:8000"
