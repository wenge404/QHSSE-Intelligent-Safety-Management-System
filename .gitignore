# ---- Data & model artifacts ----
# Raw PHMSA datasets are large and re-downloadable; keep them out of Git.
ml-service/data/*
!ml-service/data/.gitkeep
ml-service/models/*
!ml-service/models/.gitkeep
*.csv
*.xlsx
*.zip
*.pkl
*.joblib
*.onnx

