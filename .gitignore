# ---- Environment ----
.env
.env.local
.env.*.local
!.env.example

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Next.js ----
.next/
out/
build/
next-env.d.ts

# ---- TypeScript build output ----
dist/
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Data & model artifacts ----
# Raw PHMSA datasets are large and re-downloadable; keep them out of Git.
ml-service/data/*
!ml-service/data/.gitkeep
ml-service/models/*
!ml-service/models/.gitkeep
*.csv
*.xlsx
*.zip
*.pkl
*.joblib
*.onnx

# The evaluation report and figures ARE committed — they are the evidence
# behind docs/ml-evaluation.md and are small. Regenerate with
# `python train.py` from ml-service/.
!ml-service/reports/
!ml-service/reports/*.json
!ml-service/reports/*.png

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Logs & coverage ----
logs/
*.log
coverage/

# ---- Claude Code local settings ----
.claude/
